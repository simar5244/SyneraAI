{
  "name": "SyneraAI",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered organization structure simulation platform",
  "scripts": {
    "dev": "concurrently \"next dev\" \"npx stripe listen --forward-to http://localhost:3333/webhook\" \"python3 ./scripts/stripe_webhook_service.py\" \"python3 ./employee_utilization_analyzer.py --watch\" \"bash ./start_successor_cron.sh\" \"bash ./start_attrition_analyzer.sh\" \"node ./scripts/auth-sync.js\" \"python3 attrition_score.py --watch\" \"node scripts/scheduled-reports-daemon.js\"",
    "predev": "echo 'Flask endpoints are now integrated into Next.js API routes'",
    "build": "next build",
    "start": "concurrently \"next start\" \"python3 ./employee_utilization_analyzer.py\" \"bash ./start_successor_cron.sh\" \"bash ./start_attrition_analyzer.sh\" \"node ./scripts/auth-sync.js\" \"python3 attrition_score.py --watch\" \"node scripts/scheduled-reports-daemon.js\"",
    "lint": "next lint",
    "auth-sync": "node ./scripts/auth-sync.js",
    "auth-migration": "node ./scripts/auth-migration.js",
    "attrition-analyze": "python3 attrition_score.py",
    "scheduled-reports": "node scripts/scheduled-reports-daemon.js",
    "scheduled-reports:once": "node scripts/check-scheduled-reports.js --once",
    "scheduled-reports:force": "node scripts/check-scheduled-reports.js --force --once",
    "setup-scheduled-reports": "./scripts/run-scheduled-reports.sh --setup-cron"
  },
