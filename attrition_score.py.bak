def calculate_attrition_score(doc: Dict[str, Any]) -> Dict[str, Any]:
    """
    Calculate attrition score based on various factors
    
    This combines multiple risk factors into a single attrition score
    with detailed explanations of contributing factors
    """
    # Ensure doc is a dictionary
    if not isinstance(doc, dict):
        logging.error(f"Invalid document format: {type(doc)}")
        return {
            "timestamp": datetime.now().isoformat(),
            "email": "unknown",
            "error": "Invalid document format"
        }
    
    # Extract relevant fields with robust fallbacks
    email = doc.get("email", "unknown")
    
    # Log data quality
    logging.info(f"Calculating attrition score for {email}")
    
    try:
        # Extract basic employee data
        job_title = doc.get("role", "") or doc.get("jobTitle", "")
        job_duties_raw = doc.get("jobDuties", []) or doc.get("jobResponsibilities", [])
        
        job_duties = []
        if isinstance(job_duties_raw, list):
            # Handle both string and dictionary formats
            for duty in job_duties_raw:
                if isinstance(duty, str):
                    job_duties.append(duty)
                elif isinstance(duty, dict) and "description" in duty:
                    job_duties.append(duty["description"])
                elif isinstance(duty, dict) and "duty" in duty:
                    job_duties.append(duty["duty"])
        
        # Extract projects
        projects = doc.get("projects", [])
        
        # Extract tools
        tools_raw = doc.get("toolsProficient", [])
        tools = []
        if isinstance(tools_raw, list):
            for tool in tools_raw:
                if isinstance(tool, str):
                    tools.append(tool)
                elif isinstance(tool, dict) and "name" in tool:
                    tools.append(tool["name"])
        elif isinstance(tools_raw, str):
            tools = [t.strip() for t in tools_raw.split(",")]
        
        # Extract time with company and in role
        time_with_company_str = doc.get("timeWithCompany", "")
        time_in_role_str = doc.get("timeInCurrentRole", "")
        
        time_with_company_months = doc.get("timeWithCompanyMonths", 0)
        time_in_role_months = doc.get("timeInCurrentRoleMonths", 0)
        
        # Get other assessments
        utilization_assessment = doc.get("utilizationAssessment", {})
        job_intensity_analysis = doc.get("job_intensity_analysis", {})
        
        # Location and work mode
        location = doc.get("location", "")
        work_mode = doc.get("workMode", "") or "on-site"  # Default to on-site if not specified
        
        # Company details
        company_name = doc.get("company_name", "")
        industry = doc.get("industry", "")
        
        # Salary information (if available)
        salary = 0
        salary_history = doc.get("salaryHistory", [])
        if salary_history and isinstance(salary_history, list) and len(salary_history) > 0:
            latest_salary = salary_history[-1]
            if isinstance(latest_salary, dict):
                salary = latest_salary.get("amount", 0)
        
        # Calculate factors that contribute to attrition risk
        try:
            responsibility_mismatch = calculate_responsibility_mismatch(job_duties, job_title)
        except Exception as e:
            logging.error(f"calculate_responsibility_mismatch not available, using stub fallback")
            responsibility_mismatch = {
                "mismatch_score": 0.5,
                "confidence": 0.3,
                "explanation": "Could not calculate responsibility mismatch"
            }
            
        try:
            tenure_factor = calculate_tenure_factor(time_with_company_months, time_in_role_months)
        except Exception as e:
            logging.error(f"calculate_tenure_factor not available, using stub fallback")
            tenure_factor = {
                "tenure_factor": 0.5,
                "confidence": 0.3,
                "explanation": "Could not calculate tenure factor"
            }
            
        try:
            utilization_factor = calculate_utilization_factor(utilization_assessment)
        except Exception as e:
            logging.error(f"calculate_utilization_factor not available, using stub fallback")
            utilization_factor = {
                "utilization_factor": 0.5,
                "confidence": 0.3,
                "explanation": "Could not calculate utilization factor"
            }
            
        try:
            seniority_factor = calculate_seniority_factor(job_title)
        except Exception as e:
            logging.error(f"calculate_seniority_factor not available, using stub fallback")
            seniority_factor = {
                "seniority_factor": 0.5,
                "confidence": 0.3,
                "explanation": "Could not calculate seniority factor"
            }
            
        try:
            task_variety_index = calculate_task_variety_index(job_duties, projects, tools)
        except Exception as e:
            logging.error(f"calculate_task_variety_index not available, using stub fallback")
            task_variety_index = {
                "task_variety_index": 0.5,
                "confidence": 0.3,
                "explanation": "Could not calculate task variety index"
            }
            
        try:
            job_intensity_factor = calculate_job_intensity_factor(job_intensity_analysis)
        except Exception as e:
            logging.error(f"calculate_job_intensity_factor not available, using stub fallback")
            job_intensity_factor = {
                "job_intensity_factor": 0.5,
                "confidence": 0.3,
                "explanation": "Could not calculate job intensity factor"
            }
            
        try:
            role_project_ratio = calculate_role_project_ratio(projects, seniority_factor.get("seniority_factor", 0.5))
        except Exception as e:
            logging.error(f"calculate_role_project_ratio not available, using stub fallback")
            role_project_ratio = {
                "role_project_ratio": 0.5,
                "confidence": 0.3,
                "explanation": "Could not calculate role project ratio"
            }
            
        try:
            collaboration_factor = calculate_collaboration_factor(doc)
        except Exception as e:
            logging.error(f"calculate_collaboration_factor not available, using stub fallback")
            collaboration_factor = {
                "collaboration_factor": 0.5,
                "confidence": 0.3,
                "explanation": "Could not calculate collaboration factor"
            }
            
        try:
            salary_satisfaction = calculate_salary_satisfaction(
                salary, job_title, work_mode, location, industry, doc)
        except Exception as e:
            logging.error(f"calculate_salary_satisfaction not available, using stub fallback")
            salary_satisfaction = {
                "salary_satisfaction": 0.5,
                "confidence": 0.3,
                "explanation": "Could not calculate salary satisfaction"
            }
        
        # Compute weighted attrition score
        factor_scores = {
            "responsibility_mismatch": {
                "weight": 0.15,
                "score": responsibility_mismatch.get("mismatch_score", 0.5),
                "explanation": responsibility_mismatch.get("explanation", "")
            },
            "tenure_factor": {
                "weight": 0.1,
                "score": tenure_factor.get("tenure_factor", 0.5),
                "explanation": tenure_factor.get("explanation", "")
            },
            "utilization_factor": {
                "weight": 0.15,
                "score": utilization_factor.get("utilization_factor", 0.5),
                "explanation": utilization_factor.get("explanation", "")
            },
            "seniority_factor": {
                "weight": 0.05,
                "score": seniority_factor.get("seniority_factor", 0.5),
                "explanation": seniority_factor.get("explanation", "")
            },
            "task_variety_index": {
                "weight": 0.1,
                "score": task_variety_index.get("task_variety_index", 0.5),
                "explanation": task_variety_index.get("explanation", "")
            },
            "job_intensity_factor": {
                "weight": 0.15,
                "score": job_intensity_factor.get("job_intensity_factor", 0.5),
                "explanation": job_intensity_factor.get("explanation", "")
            },
            "role_project_ratio": {
                "weight": 0.05,
                "score": role_project_ratio.get("role_project_ratio", 0.5),
                "explanation": role_project_ratio.get("explanation", "")
            },
            "collaboration_factor": {
                "weight": 0.1,
                "score": collaboration_factor.get("collaboration_factor", 0.5),
                "explanation": collaboration_factor.get("explanation", "")
            },
            "salary_satisfaction": {
                "weight": 0.15,
                "score": salary_satisfaction.get("salary_satisfaction", 0.5),
                "explanation": salary_satisfaction.get("explanation", "")
            }
        }
        
        # Calculate weighted score
        weighted_score = sum(
            factor_data["weight"] * factor_data["score"] 
            for factor, factor_data in factor_scores.items()
        )
        
        # Determine primary risk factors (highest scores)
        risk_factors = [
            {
                "factor": factor,
                "score": factor_data["score"],
                "explanation": factor_data["explanation"]
            }
            for factor, factor_data in factor_scores.items()
            if factor_data["score"] > 0.6  # High risk threshold
        ]
        
        # Sort by score (highest first)
        risk_factors.sort(key=lambda x: x["score"], reverse=True)
        
        # Determine confidence level
        confidence_scores = [
            responsibility_mismatch.get("confidence", 0.3),
            tenure_factor.get("confidence", 0.3),
            utilization_factor.get("confidence", 0.3),
            seniority_factor.get("confidence", 0.3),
            task_variety_index.get("confidence", 0.3),
            job_intensity_factor.get("confidence", 0.3),
            role_project_ratio.get("confidence", 0.3),
            collaboration_factor.get("confidence", 0.3),
            salary_satisfaction.get("confidence", 0.3)
        ]
        
        confidence_score = sum(confidence_scores) / len(confidence_scores)
        
        # Generate summary
        if weighted_score >= 0.8:
            summary = "Very high attrition risk"
        elif weighted_score >= 0.6:
            summary = "High attrition risk"
        elif weighted_score >= 0.4:
            summary = "Moderate attrition risk"
        elif weighted_score >= 0.2:
            summary = "Low attrition risk"
        else:
            summary = "Very low attrition risk"
        
        # Add primary risk factors to summary
        if risk_factors:
            summary += f". Primary concerns: {risk_factors[0]['factor'].replace('_', ' ')}"
            if len(risk_factors) > 1:
                summary += f" and {risk_factors[1]['factor'].replace('_', ' ')}"
        
        # Create result
        result = {
            "timestamp": datetime.now().isoformat(),
            "email": email,
            "attrition_score": weighted_score,
            "confidence_score": confidence_score,
            "summary": summary,
            "factor_scores": factor_scores,
            "primary_risk_factors": risk_factors[:3]  # Top 3 risk factors
        }
        
        return result
    
    except Exception as e:
        logging.error(f"Error in attrition calculation for {email}: {str(e)}")
        import traceback
        logging.error(traceback.format_exc())
        
        return {
            "timestamp": datetime.now().isoformat(),
            "email": email,
            "error": f"Calculation error: {str(e)}",
            "attrition_score": 0.5,  # Default score
            "confidence_score": 0.1,  # Low confidence due to error
            "summary": "Could not calculate attrition risk due to error"
        }

def watch_single_database(db_name, db):
    """Watch for changes in a single database"""
    logging.info(f"Starting change stream on {db_name}.{USERS_COLLECTION}...")
    
    try:
        # Watch for any changes in the users collection 
        pipeline = [
            {"$match": {
                "$and": [
                    {"operationType": {"$in": ["insert", "update", "replace"]}},
                    # Skip our own updates to attritionAssessment to avoid infinite loops
                    {"updateDescription.updatedFields.attritionAssessment": {"$exists": False}},
                    # Only watch for fields that affect attrition score
                    {"$or": [
                        {"updateDescription.updatedFields.jobDuties": {"$exists": True}},
                        {"updateDescription.updatedFields.jobResponsibilities": {"$exists": True}},
                        {"updateDescription.updatedFields.toolsProficient": {"$exists": True}},
                        {"updateDescription.updatedFields.projects": {"$exists": True}},
                        {"updateDescription.updatedFields.timeWithCompany": {"$exists": True}},
                        {"updateDescription.updatedFields.timeInCurrentRole": {"$exists": True}},
                        {"updateDescription.updatedFields.utilizationAssessment": {"$exists": True}},
                        {"updateDescription.updatedFields.job_intensity_analysis": {"$exists": True}},
                        {"updateDescription.updatedFields.salaryHistory": {"$exists": True}},
                        {"fullDocument.jobDuties": {"$exists": True}},
                        {"fullDocument.jobResponsibilities": {"$exists": True}},
                        {"fullDocument.toolsProficient": {"$exists": True}},
                        {"fullDocument.projects": {"$exists": True}},
                        {"operationType": "insert"}  # Always process new documents
                    ]}
                ]
            }}
        ]
        
        with db[USERS_COLLECTION].watch(
            pipeline=pipeline, 
            full_document='updateLookup'
        ) as stream:
            for change in stream:
                try:
                    operation_type = change.get("operationType")
                    document = change.get("fullDocument")
                    
                    if not document:
                        logging.warning(f"Change event without full document in {db_name}")
                        continue
                        
                    email = document.get("email")
                    if not email:
                        logging.warning(f"Document without email in {db_name}: {document.get('_id')}")
                        continue
                    
                    # Check if the change was to attritionAssessment field
                    if operation_type == "update":
                        updated_fields = change.get("updateDescription", {}).get("updatedFields", {})
                        if "attritionAssessment" in updated_fields:
                            logging.info(f"Skipping our own update for {email} in {db_name}")
                            continue
                    
                    logging.info(
                        f"Processing attrition update for {email} in {db_name} (operation: {operation_type})"
                    )
                    
                    # Process only this specific document
                    process_single_document(email, db_name)
                    
                except Exception as e:
                    logging.error(
                        f"Error handling change event in {db_name}: {e}"
                    )
                    # Include more details for debugging
                    import traceback
                    logging.error(traceback.format_exc())
    
    except Exception as e:
        logging.error(f"Error setting up change stream for {db_name}: {e}")
        # Try to reconnect after a delay
        time.sleep(10)
        
        # Reconnect just for this database
        try:
            if client:
                db = client[db_name]
                active_dbs[db_name] = db
                watch_single_database(db_name, db)
        except Exception as reconnect_error:
            logging.error(f"Failed to reconnect to {db_name}: {reconnect_error}")

def process_single_document(email: str, db_name: str = None) -> Optional[Dict[str, Any]]:
    """
    Process attrition score for a single document by email
    
    Args:
        email: Email of the employee to analyze
        db_name: Optional database name to search in
    
    Returns:
        Attrition assessment result or None if processing failed
    """
    global active_dbs
    
    if not active_dbs:
        logging.error("No active databases available")
        return None
    
    # If db_name wasn't specified, search all databases
    dbs_to_check = {db_name: active_dbs[db_name]} if db_name and db_name in active_dbs else active_dbs
    
    for current_db_name, db in dbs_to_check.items():
        try:
            # Find the employee by email
            employee = db[USERS_COLLECTION].find_one({"email": email})
            
            if employee:
                # Calculate attrition score
                attrition_assessment = calculate_attrition_score(employee)
                
                # Update in users collection
                db[USERS_COLLECTION].update_one(
                    {"email": email}, 
                    {"$set": {"attritionAssessment": attrition_assessment}}
                )
                
                logging.info(f"Processed attrition assessment for {email} in {current_db_name}")
                return attrition_assessment
        
        except Exception as e:
            logging.error(f"Error processing attrition assessment for {email} in {current_db_name}: {e}")
    
    logging.warning(f"Employee not found for email: {email}")
    return None

def watch_for_changes():
    """Start watching for changes across all databases"""
    global active_dbs
    
    if not active_dbs:
        logging.warning("No active databases available for change streams")
        return
    
    import threading
    
    # Create a thread for each database
    for db_name, db in active_dbs.items():
        thread = threading.Thread(
            target=watch_single_database,
            args=(db_name, db),
            daemon=True
        )
        thread.start()
        logging.info(f"Started change stream thread for {db_name}")

def process_all_documents():
    """Process all documents across all databases"""
    global active_dbs
    
    if not active_dbs:
        logging.warning("No active databases available. Attempting to reconnect.")
        connect_db()
        if not active_dbs:
            logging.error("Database connection failed. Cannot process documents.")
            return 0
    
    # Refresh the database list to ensure we have the latest databases
    refresh_database_list()
    logging.info(f"Processing documents across {len(active_dbs)} databases")
    
    # Keep track of total documents processed
    total_processed = 0
    
    # Process each active database
    for db_name, db in active_dbs.items():
        logging.info(f"Processing documents in {db_name} database...")
        
        # Get all documents from users collection
        users_cursor = db[USERS_COLLECTION].find()
        
        # Process each document
        processed_count = 0
        for doc in users_cursor:
            try:
                email = doc.get("email")
                if not email:
                    continue
                
                logging.info(f"Processing attrition assessment for {email}")
                
                # Calculate attrition score
                attrition_assessment = calculate_attrition_score(doc)
                
                # Update document with assessment
                db[USERS_COLLECTION].update_one(
                    {"email": email}, 
                    {"$set": {"attritionAssessment": attrition_assessment}}
                )
                
                processed_count += 1
                
            except Exception as e:
                logging.error(f"Error in attrition calculation for {doc.get('email', 'unknown')}: {str(e)}")
        
        total_processed += processed_count
        logging.info(f"Completed processing {processed_count} documents in {db_name}")
    
    logging.info(f"Total documents processed across all databases: {total_processed}")
    return total_processed

if __name__ == "__main__":
    import argparse
    import sys
    
    # Parse command line arguments
    parser = argparse.ArgumentParser(description='Attrition Score Analyzer')
    parser.add_argument('--watch', action='store_true', help='Run in continuous watch mode')
    parser.add_argument('--email', help='Email of employee to analyze')
    parser.add_argument('--db', help='Database name to process (optional)')
    parser.add_argument('--npm', action='store_true', help='Flag to indicate running from npm script')
    args = parser.parse_args()
    
    # Check if being run from npm
    is_npm_run = args.npm or any(arg in ' '.join(sys.argv) for arg in ['npm', 'node'])
    
    # Connect to the database
    connect_db()
    
    # Load models and initialize indexes
    load_model()
    initialize_vector_indexes()
    
    if args.email:
        # Process a single employee
        process_single_document(args.email, args.db)
        sys.exit(0)
    
    # Default to processing all documents and watching for changes
    # when started with npm run or --watch flag
    if args.watch or is_npm_run:
        # Process all documents first
        process_all_documents()
        
        # Then start watching for changes
        watch_for_changes()
        
        # Keep the main thread alive
        try:
            logging.info("Attrition Score Analyzer is now watching for changes...")
            logging.info("Press Ctrl+C to exit.")
            while True:
                time.sleep(3600)  # Sleep for an hour
        except KeyboardInterrupt:
            logging.info("Received keyboard interrupt, shutting down...")
    else:
        # Just process all documents and exit
        process_all_documents()
        logging.info("Initial processing completed. Exiting.")
