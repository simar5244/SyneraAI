  /**
   * Calculate aggregated score for an employee (primarily reads from User model now)
   */
  async calculateAggregatedScore(evaluatedEmail: string, company: string, quarter?: string) {
    await connectDB();

    // If quarter is specified, we need to calculate on the fly for that specific quarter
    if (quarter) {
      const query: any = {
        documentType: 'feedback',
        evaluatedEmail: { $regex: `^${evaluatedEmail}$`, $options: 'i' },
        $or: [
          { companyCode: company },
          { company: company }
        ],
        quarter: quarter
      };
      const feedbacks = await Feedback.find(query);

      if (feedbacks.length === 0) {
        return {
          count: 0,
          averageRating: 0,
          weightedAverageRating: 0,
          skillsFeedback: { given: [], received: [] }
        };
      }

      // Calculate average ratings
      const totalRating = feedbacks.reduce((sum, fb) => sum + (fb.averageRating || 0), 0);
      const totalWeightedRating = feedbacks.reduce((sum, fb) => sum + (fb.weightedRating || 0), 0);

      return {
        count: feedbacks.length,
        averageRating: totalRating / feedbacks.length,
        weightedAverageRating: totalWeightedRating / feedbacks.length,
        skillsFeedback: { given: [], received: [] } // Would need to aggregate skills
      };
    }

    // Otherwise, get the overall metrics stored in the user profile (case-insensitive)
    const user = await User.findOne({ email: { $regex: `^${evaluatedEmail}$`, $options: 'i' } });
    if (!user || !user.feedbackMetrics) {
      // Should ideally not happen after feedback is submitted, but calculate if needed
      const metrics = await this.calculateUserFeedbackMetrics(evaluatedEmail, company);
      return {
        count: metrics.feedbackReceived.count,
        averageRating: metrics.feedbackReceived.averageRating,
        weightedAverageRating: metrics.feedbackReceived.weightedAverageRating,
        skillsFeedback: metrics.skillsFeedback || { given: [], received: [] }
      };
    }

    // Return metrics from user profile
    return {
      count: user.feedbackMetrics.received.count,
      averageRating: user.feedbackMetrics.received.averageRating,
      weightedAverageRating: user.feedbackMetrics.received.weightedAverageRating,
      skillsFeedback: user.skillsFeedback || { given: [], received: [] }
    };
  }

