  /**
   * Update feedback metrics for a user and store in user model
   */
  async updateUserFeedbackMetrics(
    email: string,
    company: string,
    evaluatorAvgRatingGiven?: number
  ) {
    await connectDB();
    // Calculate all feedback metrics using the static method
    const metrics = await this.calculateUserFeedbackMetrics(email, company);

    // Apply 10% reduction if applicable (only when updating the evaluated user)
    let finalWeightedAverage = metrics.feedbackReceived.weightedAverageRating;

    if (evaluatorAvgRatingGiven !== undefined && evaluatorAvgRatingGiven >= 4.5) {
      // Recalculate the weighted average, applying reduction to the latest feedback score
      const feedbackReceived = await Feedback.find({
        documentType: 'feedback',
        evaluatedEmail: email,
        $or: [
          { companyCode: company },
          { company: company }
        ]
      }).sort({ createdAt: -1 }); // Get latest feedback first

      if (feedbackReceived.length > 0) {
        let totalWeightedScore = 0;
        feedbackReceived.forEach((fb, index) => {
          let score = fb.weightedRating || 0;
          // Apply reduction only to the most recent feedback if evaluator rating is high
          if (index === 0) {
            score *= 0.9;
          }
          totalWeightedScore += score;
        });
        finalWeightedAverage = totalWeightedScore / feedbackReceived.length;
      }
    }

    // Update metrics for user - use case-insensitive email match
    await User.findOneAndUpdate(
      { email: { $regex: `^${email}$`, $options: 'i' } },
      {
        $set: {
          feedbackMetrics: {
            given: {
              count: metrics.feedbackGiven.count,
              averageRating: metrics.feedbackGiven.averageRating
            },
            received: {
              count: metrics.feedbackReceived.count,
              averageRating: metrics.feedbackReceived.averageRating,
              weightedAverageRating: finalWeightedAverage // Use potentially reduced average
            }
          },
          skillsFeedback: {
            given: metrics.skillsFeedback.given,
            received: metrics.skillsFeedback.received
          }
        }
      }
    );

    return metrics;
  }

