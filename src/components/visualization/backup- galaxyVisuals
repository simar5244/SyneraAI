          top: y,
          transform: 'translate(0, -100%)',
          marginTop: '-8px',
          minWidth: '120px',
          textAlign: 'center'
        }}
      >
        {text}
      </div>
    );
  };

  // Function to close sidebar
  const closeSidebar = () => {
    setSidebarData(null);
  };

  // Handler for mouse movement and hover effects
  useEffect(() => {
    if (!containerRef.current || !sceneRef.current || !cameraRef.current) return;
    
    const container = containerRef.current;
    
    // Mouse move handler for hover effects
    const handleMouseMove = (event: MouseEvent) => {
      // Calculate mouse position in normalized device coordinates (-1 to +1)
      const rect = container.getBoundingClientRect();
      mouseRef.current.x = ((event.clientX - rect.left) / container.clientWidth) * 2 - 1;
      mouseRef.current.y = -((event.clientY - rect.top) / container.clientHeight) * 2 + 1;
      
      if (!raycasterRef.current || !sceneRef.current || !cameraRef.current) return;
      
      // Update the raycaster
      raycasterRef.current.setFromCamera(mouseRef.current, cameraRef.current);
      
      // Calculate objects intersecting the picking ray
      const intersects = raycasterRef.current.intersectObjects(sceneRef.current.children, true);
      
      // Reset cursor
      document.body.style.cursor = 'default';
      
      // Hide tooltip by default
      setTooltip({ visible: false, text: '', x: 0, y: 0 });
      
      // Check for intersections with nodes or connections
      for (const intersect of intersects) {
        // Find the parent object which has userData
        let currentObject: THREE.Object3D | null = intersect.object;
        
        while (currentObject && (!currentObject.userData || !currentObject.userData.type)) {
          currentObject = currentObject.parent;
        }
        
        if (!currentObject || !currentObject.userData) continue;
        
        document.body.style.cursor = 'pointer';
        
        if (currentObject.userData.type === 'node') {
          const node = currentObject.userData.node;
          
          // IMPORTANT FIX: Show jobTitle in tooltip
          console.log("Hovering over node with data:", node); // Debug logging
          
          if (node.jobTitle) {
            setTooltip({
              visible: true,
              text: node.jobTitle,
              x: event.clientX + 10,
              y: event.clientY + 10
            });
          } else {
            setTooltip({
              visible: true,
              text: "Employee",
              x: event.clientX + 10,
              y: event.clientY + 10
            });
          }
          
          break;
        } else if (currentObject.userData.type === 'connection') {
          const connectionData = currentObject.userData.connectionData;
          
          // Show tooltip with connection information
          setTooltip({
            visible: true,
            text: `${connectionData.source.name} → ${connectionData.target.name} (${
              connectionData.type === 'reporting' ? 'Reports to' : 'Collaborates with'
            })`,
            x: event.clientX + 10,
            y: event.clientY + 10
          });
          
          break;
        }
      }
    };
    
    // Click handler for selection
    const handleClick = (event: MouseEvent) => {
      if (!raycasterRef.current || !sceneRef.current || !cameraRef.current) return;
      
      // Update the raycaster
      const rect = container.getBoundingClientRect();
      mouseRef.current.x = ((event.clientX - rect.left) / container.clientWidth) * 2 - 1;
      mouseRef.current.y = -((event.clientY - rect.top) / container.clientHeight) * 2 + 1;
      
      raycasterRef.current.setFromCamera(mouseRef.current, cameraRef.current);
      
      // Calculate objects intersecting the picking ray
      const intersects = raycasterRef.current.intersectObjects(sceneRef.current.children, true);
      
      // Reset selection
      setSelectedNode(null);
      setSelectedConnection(null);
      
      // Check for intersections with nodes or connections
      for (const intersect of intersects) {
        // Find the parent object which has userData
        let currentObject: THREE.Object3D | null = intersect.object;
        
        while (currentObject && (!currentObject.userData || !currentObject.userData.type)) {
          currentObject = currentObject.parent;
        }
        
        if (!currentObject || !currentObject.userData) continue;
        
        if (currentObject.userData.type === 'node') {
          const node = currentObject.userData.node;
          console.log("Clicked on node:", node);
          console.log("Node jobTitle:", node.jobTitle);
          setSelectedNode(node);
          setSidebarType('employee');
          setSidebarData(node);
          break;
        } else if (currentObject.userData.type === 'connection') {
          const connectionData = currentObject.userData.connectionData;
          setSelectedConnection(connectionData);
          setSidebarType('connection');
          setSidebarData(connectionData);
          break;
        }
      }
    };

    // Add event listeners
    container.addEventListener('mousemove', handleMouseMove);
    container.addEventListener('click', handleClick);
    
    // Cleanup
    return () => {
      container.removeEventListener('mousemove', handleMouseMove);
      container.removeEventListener('click', handleClick);
    };
  }, []);

  // Set up keyboard controls
  useEffect(() => {
    if (!cameraRef.current || !controlsRef.current) return;

    const handleKeyDown = (event: KeyboardEvent) => {
      if (keyStateRef.current.hasOwnProperty(event.key)) {
        keyStateRef.current[event.key] = true;
      }
    };
  

    const handleKeyUp = (event: KeyboardEvent) => {
      if (keyStateRef.current.hasOwnProperty(event.key)) {
        keyStateRef.current[event.key] = false;
      }
    };

    // Animation loop for keyboard movement
    const animate = () => {
      const moveSpeed = 1.0;
      const camera = cameraRef.current;
      
      if (camera) {
        // Forward/backward movement
        if (keyStateRef.current.w || keyStateRef.current.W || keyStateRef.current.ArrowUp) {
          camera.position.z -= moveSpeed;
        }
        if (keyStateRef.current.s || keyStateRef.current.S || keyStateRef.current.ArrowDown) {
          camera.position.z += moveSpeed;
        }
        
        // Left/right movement
        if (keyStateRef.current.a || keyStateRef.current.A || keyStateRef.current.ArrowLeft) {
          camera.position.x -= moveSpeed;
        }
        if (keyStateRef.current.d || keyStateRef.current.D || keyStateRef.current.ArrowRight) {
          camera.position.x += moveSpeed;
        }
      }
      
      requestRef.current = requestAnimationFrame(animate);
    };

    // Start animation
    animate();
    
    // Add event listeners
    window.addEventListener('keydown', handleKeyDown);
    window.addEventListener('keyup', handleKeyUp);
    
    // Cleanup
    return () => {
      window.removeEventListener('keydown', handleKeyDown);
      window.removeEventListener('keyup', handleKeyUp);
      cancelAnimationFrame(requestRef.current as number);
    };
  }, []);

