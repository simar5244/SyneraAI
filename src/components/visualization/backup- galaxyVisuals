    if (!showLegend) return null;
    
    return (
      <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/50 backdrop-blur-sm">
        <div className="bg-gray-800 text-white p-6 rounded-lg max-w-md">
          <div className="flex justify-between items-center mb-4">
            <h3 className="text-lg font-bold">Department Colors</h3>
            <button 
              onClick={toggleLegend}
              className="text-gray-400 hover:text-white"
            >
              <X size={20} />
            </button>
          </div>
          <div className="grid grid-cols-2 gap-3">
            {Object.entries(departmentColors).map(([dept, color]) => (
              dept !== 'default' && (
                <div key={dept} className="flex items-center space-x-2">
                  <div 
                    className="w-5 h-5 rounded-full" 
                    style={{ backgroundColor: color, boxShadow: `0 0 10px ${color}` }}
                  />
                  <span className="text-sm">{dept}</span>
                </div>
              )
            ))}
          </div>
        </div>
      </div>
    );
  };

  // Helper to get risk level text based on score - enhance with color
  const getRiskLevel = (score: number): JSX.Element => {
    let color: string;
    let text: string;
    
    if (score > 0.7) {
      color = 'text-red-400';
      text = 'High';
    } else if (score > 0.4) {
      color = 'text-yellow-400';
      text = 'Medium';
    } else {
      color = 'text-green-400';
      text = 'Low';
    }
    
    return (
      <span className={`font-medium ${color}`}>
        {text}
      </span>
    );
  };

  // Main component render
  return (
    <>
      <div ref={containerRef} className="w-full h-full bg-black"></div>
      
      {/* Control buttons with improved visibility and spacing */}
      <div className="fixed bottom-4 left-4 z-50 flex space-x-3 p-2 bg-gray-800/90 backdrop-blur-md rounded-lg shadow-lg">
        {/* Close button to return to visualization page */}
        <button 
          onClick={handleBackNavigation}
          className="bg-gray-700 text-white p-2 rounded-full hover:bg-gray-600 transition-colors shadow-md"
          title="Back to Visualizations"
        >
          <X size={20} />
        </button>
        
        {/* Info button for keyboard controls */}
        <button 
          onClick={toggleKeyboardHelp}
          className="bg-gray-700 text-white p-2 rounded-full hover:bg-gray-600 transition-colors shadow-md"
          title="Keyboard Controls"
        >
          <Info size={20} />
        </button>
        
        {/* Legend button for department colors */}
        <button 
          onClick={toggleLegend}
          className="bg-gray-700 text-white p-2 rounded-full hover:bg-gray-600 transition-colors shadow-md"
          title="Department Legend"
        >
          <List size={20} />
        </button>
      </div>
      
      {/* Keyboard help modal */}
      <KeyboardHelpModal />
      
      {/* Legend modal */}
      <LegendModal />
      
      {/* Tooltip for hover information */}
      <Tooltip {...tooltip} />
      
      {/* Side panel for detailed information */}
      {sidebarData && (
        <SidePanel
          data={sidebarData}
          type={sidebarType}
          onClose={closeSidebar}
        />
      )}
    </>
  );
} 